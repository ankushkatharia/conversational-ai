# ---------------------------------------------------------------------------
# Under Armour Shopping Assistant - environment configuration
# Copy to `.env.local` and adjust. Never put secrets in NEXT_PUBLIC_* values.
# ---------------------------------------------------------------------------

# Public app name (safe to expose to the browser).
NEXT_PUBLIC_APP_NAME=Under Armour Shopping Assistant

# Base URL the browser uses to reach the app's own API (BFF).
# Leave empty to use same-origin "/api" (recommended).
NEXT_PUBLIC_API_BASE_URL=

# ------------------------- server-only (not exposed) -----------------------

# When "true", the app serves fully mocked data and needs no backend at all.
# When "false" (or unset), the BFF proxies chat to AGENT_API_BASE_URL and
# falls back to mock data if the backend is unreachable.
USE_MOCK=true

# The conversation backend (mcp-uacapi HTTP API). Server-side only.
#   POST /agent  { prompt }            -> { answer, toolCalls }
#   POST /search { query, limit, ... } -> stable product search result
AGENT_API_BASE_URL=http://localhost:8787

# Secret used to sign local session cookies. Change in any real deployment.
AUTH_SESSION_SECRET=dev-only-change-me
