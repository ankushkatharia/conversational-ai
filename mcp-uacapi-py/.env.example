# Settings for mcp-uacapi-py. Names match ../mcp-uacapi/.env, so that file also works here.
# A blank value (KEY=) means "use the default".

# --- Service ---
LOG_LEVEL=INFO
# Comma-separated list. Restrict to the storefront origins in production.
CORS_ALLOW_ORIGINS=*

# --- LLM ---
# Which provider answers chat requests: openai or anthropic.
LLM_PROVIDER=openai
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# Master switch for prompt-caching features (cache markers, cache keys, retention).
LLM_PROMPT_CACHING=true

# OpenAI, or any OpenAI-compatible endpoint (e.g. AWS Bedrock gpt-oss). Leave the base URL empty for api.openai.com.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=openai.gpt-oss-120b
# OpenAI caches repeated prompt prefixes automatically. The settings below raise hit rates but are
# off by default, because not every OpenAI-compatible endpoint accepts them. For api.openai.com:
#   OPENAI_PROMPT_CACHE_KEY=ua-agent         (the server appends a per-conversation suffix)
#   OPENAI_PROMPT_CACHE_RETENTION=24h        (in_memory or 24h, model-dependent)
#   OPENAI_CACHE_BREAKPOINTS=true            (GPT-5.6 and later only)
OPENAI_PROMPT_CACHE_KEY=
OPENAI_PROMPT_CACHE_RETENTION=
OPENAI_CACHE_BREAKPOINTS=false

# Anthropic Claude. ANTHROPIC_BACKEND=api uses ANTHROPIC_API_KEY; bedrock uses the AWS_* settings below.
ANTHROPIC_BACKEND=api
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# On Bedrock use the Bedrock model or inference-profile id, e.g. global.anthropic.claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=2048
# Lifetime of the cached tools + system prompt: 5m (cheaper writes) or 1h (fewer misses on quiet traffic).
ANTHROPIC_CACHE_TTL=5m
# Bedrock credentials: a Bedrock API key, or access keys, or a profile (else the default AWS chain).
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# --- Agent loop ---
AGENT_MAX_TURNS=8
AGENT_MAX_TOOL_CALLS=3
# Prior turns sent to the LLM, and the per-turn character cap for assistant replies.
AGENT_MAX_HISTORY_TURNS=8
AGENT_MAX_ASSISTANT_CHARS=800
# Shared session for requests without a sessionId. Leave empty: a shared session mixes shoppers' conversations.
AGENT_DEFAULT_SESSION=

# --- Session memory ---
SESSION_BACKEND=memory
SESSION_MAX_TURNS=20
SESSION_MAX_SESSIONS=10000
SESSION_TTL_S=3600

# --- UACAPI ---
# GraphQL endpoint, e.g. https://uacapi.example.com/graphql
UACAPI_ENDPOINT=
# Default bearer token. A shopper's Authorization header takes precedence.
UACAPI_BEARER_TOKEN=
# Static integration token for back-office queries (orders). Prefer the Auth0 block below,
# which mints and refreshes the token automatically.
UACAPI_INTEGRATION_TOKEN=
UACAPI_AUTH0_DOMAIN=
UACAPI_AUTH0_CLIENT_ID=
UACAPI_AUTH0_CLIENT_SECRET=
UACAPI_AUTH0_AUDIENCE=https://commerce.api.ua.com
# Fallback customer number when no x-ua-customer-no header is sent (local testing only).
UACAPI_CUSTOMER_NO=
UACAPI_TIMEOUT_MS=15000
UACAPI_MAX_CONNECTIONS=100
UACAPI_IMAGE_SIZE=600

# Context headers. They change search results, so match what your Apollo Sandbox sends.
UACAPI_SITE_CODE=
UACAPI_LANGUAGE_CODE=
UACAPI_CLIENT_TYPE=
UACAPI_USER_AGENT=
# Extra headers as a JSON object, applied last, e.g. {"x-custom":"value"}
UACAPI_HEADERS=
# Set to true to log outgoing UACAPI requests.
DEBUG_UACAPI=

# --- Help / Queries email ---
# "log" records tickets in the server log instead of sending mail.
EMAIL_TRANSPORT=log
SUPPORT_EMAIL=ankush.katharia@underarmour.com
SUPPORT_EMAIL_FROM=no-reply@underarmour.com
