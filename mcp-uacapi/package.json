{
  "name": "mcp-uacapi",
  "version": "0.1.0",
  "description": "Phase 1: read-only Model Context Protocol (MCP) server exposing UACAPI product search.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-uacapi": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "agent": "npm run build && node dist/agent.js",
    "serve": "npm run build && node dist/http.js",
    "api": "node src/api.js"
  },
  "keywords": [
    "mcp",
    "uacapi",
    "graphql",
    "commerce"
  ],
  "author": "Under Armour",
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "openai": "^7.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.5.0"
  }
}
