# UACAPI GraphQL endpoint the MCP server talks to (read-only usage only).
# Example: https://uacapi.example.com/graphql
UACAPI_ENDPOINT=

# Bearer token used for the Authorization header when calling UACAPI.
# Leave empty for local dev servers that do not require auth.
UACAPI_BEARER_TOKEN=

# Integration (machine) token used ONLY for back-office queries like `orders`
# and `orderByOrderNumber` (get_orders / get_order_detail_by_order_number tools).
# Those are shield-gated and reject per-shopper tokens with "Must have an
# integration token".
#
# PREFERRED: leave this empty and configure the Auth0 client-credentials block
# below so the server auto-mints and refreshes the token (no manual pasting).
# This static value is only used as a manual override / fallback and is ignored
# once it expires if Auth0 auto-minting is configured.
UACAPI_INTEGRATION_TOKEN=

# --- Integration token auto-mint (Auth0 client-credentials / M2M) ---
# When these are set, the server mints the integration token via the Auth0 token
# endpoint, caches it until shortly before `exp`, and refreshes it automatically
# (and retries once on a 401). Only the CLIENT SECRET is sensitive; the domain,
# audience, and client id come from your UACAPI M2M application.
#   POST https://<domain>/oauth/token
#   { grant_type: "client_credentials", client_id, client_secret, audience }
UACAPI_AUTH0_DOMAIN=
UACAPI_AUTH0_CLIENT_ID=
UACAPI_AUTH0_CLIENT_SECRET=
# Optional; defaults to https://commerce.api.ua.com
UACAPI_AUTH0_AUDIENCE=

# Optional: fallback customer number for get_orders when no x-ua-customer-no
# header is sent (e.g. CLI/agent testing).
UACAPI_CUSTOMER_NO=

# Optional: per-request timeout in milliseconds (defaults to 15000).
UACAPI_TIMEOUT_MS=15000

# --- Context headers (IMPORTANT for matching results) ---
# UACAPI derives the site, locale, and client type from request headers, which
# changes search results/sorting/personalization. Set these to match the
# headers your Apollo Sandbox sends. Leave unset to use UACAPI defaults
# (site=US, language=en, client=OTHER).

# Country/site code -> header "ua-site-code" (e.g. US, GB, MX)
UACAPI_SITE_CODE=
# Language code -> header "ua-language-code" (e.g. en, es, fr)
UACAPI_LANGUAGE_CODE=
# Client type -> header "uaclienttype" (e.g. WEB, ANDROID, IOS)
UACAPI_CLIENT_TYPE=
# Optional explicit User-Agent -> header "user-agent"
UACAPI_USER_AGENT=
# Any additional headers as a JSON object (applied last, wins on conflict).
# Example: {"x-custom":"value","ua-site-code":"US"}
UACAPI_HEADERS=

# --- Help / Queries support email (create_support_ticket tool) ---
# Transport used to send support tickets. "log" (default) does NOT send real
# mail - it records the ticket to stderr (and DEBUG_UACAPI_FILE, if set) so the
# flow works end to end. Add an SMTP/provider transport in src/email/mailer.ts
# to enable real sending.
EMAIL_TRANSPORT=log
# Support inbox tickets are routed to (recipient).
SUPPORT_EMAIL=ankush.katharia@underarmour.com
# From address used on outgoing ticket emails.
SUPPORT_EMAIL_FROM=no-reply@underarmour.com

# --- Debug (optional) ---
# Set DEBUG_UACAPI=1 to log the outgoing endpoint/headers/variables/body.
# DEBUG_UACAPI_FILE additionally appends those logs to a tailable file.
DEBUG_UACAPI=
DEBUG_UACAPI_FILE=
