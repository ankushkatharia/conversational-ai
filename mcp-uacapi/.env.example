# UACAPI GraphQL endpoint the MCP server talks to (read-only usage only).
# Example: https://uacapi.example.com/graphql
UACAPI_ENDPOINT=

# Bearer token used for the Authorization header when calling UACAPI.
# Leave empty for local dev servers that do not require auth.
UACAPI_BEARER_TOKEN=

# Optional: per-request timeout in milliseconds (defaults to 15000).
UACAPI_TIMEOUT_MS=15000

# --- Context headers (IMPORTANT for matching results) ---
# UACAPI derives the site, locale, and client type from request headers, which
# changes search results/sorting/personalization. Set these to match the
# headers your Apollo Sandbox sends. Leave unset to use UACAPI defaults
# (site=US, language=en, client=OTHER).

# Country/site code -> header "ua-site-code" (e.g. US, GB, MX)
UACAPI_SITE_CODE=
# Language code -> header "ua-language-code" (e.g. en, es, fr)
UACAPI_LANGUAGE_CODE=
# Client type -> header "uaclienttype" (e.g. WEB, ANDROID, IOS)
UACAPI_CLIENT_TYPE=
# Optional explicit User-Agent -> header "user-agent"
UACAPI_USER_AGENT=
# Any additional headers as a JSON object (applied last, wins on conflict).
# Example: {"x-custom":"value","ua-site-code":"US"}
UACAPI_HEADERS=

# --- Debug (optional) ---
# Set DEBUG_UACAPI=1 to log the outgoing endpoint/headers/variables/body.
# DEBUG_UACAPI_FILE additionally appends those logs to a tailable file.
DEBUG_UACAPI=
DEBUG_UACAPI_FILE=
